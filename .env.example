# Bright Data API Configuration
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
BRIGHTDATA_DATASET_ID=gd_l1vikfch901nx3by4

# Webhook Security Token (for /api/webhooks/brightdata?secret=...)
BRIGHTDATA_WEBHOOK_SECRET=test_secret_token_123

# Database (Neon Serverless PostgreSQL - optional, falls back to local storage if omitted)
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini Multimodal Vision API
# Single Key:
# GEMINI_API_KEY=your_key_here
#
# OR Round-Robin Multi-Key Pool (3+ separate free Google accounts for 3x+ throughput):
# Option A: Comma-separated list
# GEMINI_API_KEYS=key_from_account_1,key_from_account_2,key_from_account_3
#
# Option B: Numbered keys
# GEMINI_API_KEY_1=key_from_account_1
# GEMINI_API_KEY_2=key_from_account_2
# GEMINI_API_KEY_3=key_from_account_3
#
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_RPM=14 (Base RPM per key. With 3 rotating keys, total throughput automatically scales to 42 RPM!)